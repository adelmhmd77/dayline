rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // من غير تسجيل دخول: الوصول مفتوح لمجموعة الحسابات وأفكارها بس
    match /accounts/{document=**} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
